# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloud SQL is disabled. The system uses Firebase Firestore & Chambers Cross-Device Sync.
ENABLE_CLOUDSQL="false"
# Optional SQL variables (disabled by default)
# SQL_HOST="/cloudsql/..."
# SQL_DB_NAME="postgres"

# Cloudflare Deployment Secrets (Add these to GitHub Repository Secrets for CI/CD)
# CLOUDFLARE_API_TOKEN: Cloudflare API token with 'Edit Cloudflare Workers' template permissions
# CLOUDFLARE_ACCOUNT_ID: Found on your Cloudflare dashboard right sidebar
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN_HERE"
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID_HERE"



# Optional: configure this as a Cloudflare Worker secret (do not commit a real token).
# COUNSEL_BYPASS_TOKEN is used for counsel geo-bypass verification.
