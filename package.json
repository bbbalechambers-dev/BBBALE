{
  "name": "bbbale-chambers-rebuild",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "build:cloudflare": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
